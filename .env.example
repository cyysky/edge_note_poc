# Copy to `apps/web/.env.local` for the web app, or export these for the API.
# The values below are the defaults, so an empty environment also works.

# API origin. The browser reaches it through the Next `/api` rewrite.
# This value is compiled into the Next build: restarting is not enough,
# the web app must be rebuilt if you change it.
API_BASE_URL=http://127.0.0.1:3001

# API listen port.
PORT=3001

# SQLite file. Relative paths resolve from the API process working directory,
# so prefer an absolute path when starting the API from the repo root.
DATABASE_PATH=data/displayer.db

# LFM3-Omni llama-server: chat completions and speech synthesis.
MODEL_BASE_URL=http://127.0.0.1:8080

# Where the agent's notes tools call the REST API. Defaults to the API's own
# origin; tests point it at an isolated instance.
NOTES_API_URL=http://127.0.0.1:3001
