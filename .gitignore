# --- Local model runtime (large binaries + weights, never committed) ---
models/*
!models/README.md
!models/LICENSE
runtime/

# Scratch output
out/*
!out/.gitkeep

# --- Node / TypeScript ---
node_modules/
# Next generates this file; its contents are an implementation detail (see
# node_modules/next/dist/docs/.../config/typescript.md).
next-env.d.ts
.next/
dist/
build/
*.tsbuildinfo
.turbo/
coverage/
playwright-report/
test-results/

# --- SQLite ---
*.db
*.db-journal
*.db-wal
*.db-shm
data/
e2e-data/

# --- Local TLS (private key, never committed) ---
certs/

# --- Env / logs ---
.env
.env.*
!.env.example
*.log
.patch.txt

