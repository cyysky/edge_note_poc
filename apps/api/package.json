{
  "name": "@displayer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @displayer/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @displayer/shared build",
    "build": "nest build",
    "prestart": "pnpm --filter @displayer/shared build",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @displayer/shared build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "pretest:e2e": "pnpm --filter @displayer/shared build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @displayer/shared build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@displayer/agent": "workspace:*",
    "@displayer/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "better-sqlite3": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
