{
  "name": "@displayer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @displayer/shared build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @displayer/shared build",
    "build": "next build",
    "prestart": "pnpm --filter @displayer/shared build",
    "start": "next start",
    "pretest": "pnpm --filter @displayer/shared build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "pretest:e2e": "pnpm --filter @displayer/shared build && pnpm build",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @displayer/shared build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@displayer/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "vitest": "5.1.1"
  }
}
