{
  "name": "displayer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @displayer/api dev",
    "dev:web": "pnpm --filter @displayer/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @displayer/api test:unit && pnpm --filter @displayer/web test:unit",
    "test:e2e": "pnpm --filter @displayer/api test:e2e && pnpm --filter @displayer/web test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
