{
  "name": "@displayer/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @displayer/shared build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @displayer/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @displayer/shared build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@displayer/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
